{
  "name": "whatscli-next",
  "version": "0.1.0",
  "private": true,
  "description": "A small JSON-only WhatsApp CLI for agents, using Baileys and a local Unix socket",
  "license": "MIT",
  "type": "module",
  "bin": {
    "whatscli": "dist/src/cli.js"
  },
  "files": [
    "dist/src/*.js",
    "dist/src/*.js.map",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "AGENTS.md",
    "docs/*.md",
    "docs/user/*.md",
    "docs/operations/*.md",
    "docs/internals/*.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/stamp-build.js",
    "verify:build": "node dist/scripts/verify-build.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "benchmark:store": "pnpm build && node dist/scripts/benchmark-store.js",
    "benchmark:cli": "pnpm build && node dist/scripts/benchmark-cli.js",
    "benchmark:output": "pnpm build && node dist/scripts/benchmark-output.js",
    "probe": "node dist/src/probe.js",
    "whatscli": "node dist/src/cli.js",
    "lint": "eslint --max-warnings 0 \"{src,scripts,test}/**/*.ts\" eslint.config.mjs",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\" eslint.config.mjs .prettierrc.json package.json tsconfig.json pnpm-workspace.yaml \".github/workflows/*.yml\" README.md CONTRIBUTING.md AGENTS.md \"docs/**/*.md\" patches/README.md patches/baileys-source.json",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\" eslint.config.mjs .prettierrc.json package.json tsconfig.json pnpm-workspace.yaml \".github/workflows/*.yml\" README.md CONTRIBUTING.md AGENTS.md \"docs/**/*.md\" patches/README.md patches/baileys-source.json",
    "sdk:verify": "node scripts/baileys.ts verify",
    "sdk:update": "node scripts/baileys.ts update"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "eslint": "10.13.0",
    "js-tiktoken": "1.0.21",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
