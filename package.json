{
  "name": "whatscli-next",
  "version": "0.1.0",
  "private": true,
  "description": "A small JSON-only WhatsApp CLI for agents, using Baileys and a local Unix socket",
  "license": "MIT",
  "type": "module",
  "bin": { "whatscli": "dist/src/cli.js" },
  "files": ["dist/src", "README.md", "LICENSE", "docs"],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "probe": "node dist/src/probe.js",
    "whatscli": "node dist/src/cli.js"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3"
  }
}
